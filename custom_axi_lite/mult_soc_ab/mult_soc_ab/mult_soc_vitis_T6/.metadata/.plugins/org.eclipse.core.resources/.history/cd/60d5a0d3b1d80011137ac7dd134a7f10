#include <stdio.h>
#include <stdint.h>
#include "platform.h"
#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"

#define MULT_BASE_ADDR (0x43C00000)
#define BRAM_BASE_ADDR (0x40000000)
#define FIFO_BASE_ADDR (0x43C10000)

#define A_REG_ADDR (MULT_BASE_ADDR + 0x00)
#define B_REG_ADDR (MULT_BASE_ADDR + 0x04)
#define P_REG_ADDR (MULT_BASE_ADDR + 0x08)
#define BRAM_REG_ADDR(k) (BRAM_BASE_ADDR + (k*4))

#define FIFO_REV_ADDR    (FIFO_BASE_ADDR + 0x00)
#define FIFO_RST_ADDR    (FIFO_BASE_ADDR + 0x04)
#define FIFO_WR_ADDR     (FIFO_BASE_ADDR + 0x08)
#define FIFO_REQ_ADDR    (FIFO_BASE_ADDR + 0x0C)
#define FIFO_DATA_ADDR   (FIFO_BASE_ADDR + 0x10)
#define FIFO_STATUS_ADDR (FIFO_BASE_ADDR + 0x14)
#define FIFO_COUNT_ADDR  (FIFO_BASE_ADDR + 0x18)

int main()
{
    init_platform();
    xil_printf("ECE 520/l - Custom AXI IP Lab - Anna Bagdishyan\n");
    xil_printf("Start of Multiplier Test + BRAM Test _ FIFO Test\n");

    Xil_Out32(A_REG_ADDR, 8);
    Xil_Out32(B_REG_ADDR, 8);

    for (int k = 0; k <= 31; k++)
    {
    	Xil_Out32(A_REG_ADDR, k+1);
    	Xil_Out32(B_REG_ADDR, k+1);

    	uint32_t a_val = Xil_In32(A_REG_ADDR);
    	uint32_t b_val = Xil_In32(B_REG_ADDR);
    	uint32_t p_val = Xil_In32(P_REG_ADDR);
    	Xil_Out32(BRAM_REG_ADDR(k), p_val);

    	xil_printf("Stored: %d x %d = %d at BRAM[%d]\n", a_val, b_val, p_val, k);
    }
    xil_printf("\nBRAM Contents:\n");
    for (int k = 0; k <= 31; k++)
        {
    	uint32_t bram_val = Xil_In32(BRAM_REG_ADDR(k));
    	xil_printf("BRAM[%d] = %d\n", k, bram_val);

        }

    // Test 1 - Writing and Reading two FIFO data
    xil_printf("FIFO Test 1");
    // reset FIFO
    Xil_Out32(FIFO_RST_ADDR, 1);

    // writing data to FIFO
    Xil_Out32(FIFO_WR_ADDR, 0xFAFA);
    Xil_Out32(FIFO_WR_ADDR, 0x1111);

    uint8_t count = Xil_In32(FIFO_COUNT_ADDR);
    xil_printf("\nFIFO Count After Write: %d\n", count);

    // reading FIFO
    Xil_Out32(FIFO_REQ_ADDR, 1);

    uint32_t status = Xil_In32(FIFO_STATUS_ADDR);

    if (status & 0x10)
    {
    	uint32_t data = Xil_In32(FIFO_DATA_ADDR);
    	    xil_printf("FIFO Read Data: 0x%x\n", data);
    }

    count = Xil_In32(FIFO_COUNT_ADDR);
    xil_printf("FIFO Count After First Read: %d\n", count);

    Xil_Out32(FIFO_REQ_ADDR, 1);
    if (status & 0x10)
        {
        	uint32_t data = Xil_In32(FIFO_DATA_ADDR);
        	    xil_printf("FIFO Read Data: 0x%x\n", data);
        }

        count = Xil_In32(FIFO_COUNT_ADDR);
        xil_printf("FIFO Count After Second Read: %d\n", count);

    // Test 2 - Testing reset and reading on empty
    xil_printf("FIFO Test 2");
    // writing data to FIFO
    Xil_Out32(FIFO_WR_ADDR, 0x2222);
    Xil_Out32(FIFO_WR_ADDR, 0x1234);

    Xil_Out32(FIFO_RST_ADDR, 1);

    count = Xil_In32(FIFO_COUNT_ADDR);
    xil_printf("FIFO Count After Reseting: %d\n", count); // Should be 0

    // reading FIFO
    Xil_Out32(FIFO_REQ_ADDR, 1);

    count = Xil_In32(FIFO_COUNT_ADDR);
    xil_printf("FIFO Count After Second Read: %d\n", count);

    // Test 3-
    xil_printf("End of Multiplier + BRAM Test + FIFO Test\n");

    cleanup_platform();
    return 0;
}
